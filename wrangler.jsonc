{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appp",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "532d8e9d-1efe-4cba-b1a3-8deee28d9054","database_name": "web-appp" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "e534a9af375b4fdd88d35354dfaa1a97" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
